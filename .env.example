# ============================================================
# ChowdhuryBari — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ----- Application -----
APP_NAME="ChowdhuryBari SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Locale: bn = Bengali, en = English
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Timezone (Asia/Dhaka = BST UTC+6)
APP_TIMEZONE=Asia/Dhaka

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ----- Logging -----
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Central Database -----
# The system DB: tenants, super_admins, products, orders, payments
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chowdhurybari_central
DB_USERNAME=root
DB_PASSWORD=

# ----- Tenant Database (stancl/tenancy) -----
# Template connection — stancl switches the DB name per tenant at runtime.
# Each tenant gets its own DB named: tenant_<uuid>
TENANCY_DB_CONNECTION=mysql
TENANCY_DB_HOST=127.0.0.1
TENANCY_DB_PORT=3306
TENANCY_DB_USERNAME=root
TENANCY_DB_PASSWORD=
TENANCY_DB_PREFIX=tenant_

# Central domain for multi-tenancy routing
TENANCY_CENTRAL_DOMAINS=127.0.0.1

# ----- Session -----
# IMPORTANT: SESSION_DOMAIN must match the host part of APP_URL.
# - artisan serve on 127.0.0.1:8000 → SESSION_DOMAIN=null
# - vhost chowdhurybari.test       → SESSION_DOMAIN=.chowdhurybari.test
# Wrong value causes 419 CSRF / "login expired" errors.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ----- Cache -----
CACHE_STORE=database
# CACHE_PREFIX=chowdhurybari_

# ----- Queue -----
QUEUE_CONNECTION=database

# ----- Broadcast -----
BROADCAST_CONNECTION=log

# ----- Filesystem -----
FILESYSTEM_DISK=local

# ----- Memcached -----
MEMCACHED_HOST=127.0.0.1

# ----- Redis -----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=chowdhurybari:

# ----- Mail -----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@chowdhurybari.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----- AWS S3 (optional, for file uploads) -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----- Payment Gateways (Phase 6 — leave blank until implemented) -----

# SSL Commerz (aggregator — handles bKash, Nagad, cards, banking)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_MODE=sandbox

# bKash (direct integration — lower fees)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MODE=sandbox

# Nagad (direct integration)
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_MODE=sandbox

# ----- Vite (injected at build time) -----
VITE_APP_NAME="${APP_NAME}"

# ----- Deploy Script Variables (used by deploy.sh) -----
# DEPLOY_BRANCH=main
# DEPLOY_PHP_PATH=/usr/local/bin/php
# DEPLOY_COMPOSER_PATH=/usr/local/bin/composer
# DEPLOY_NODE_PATH=/usr/local/bin/node
# DEPLOY_NPM_PATH=/usr/local/bin/npm
